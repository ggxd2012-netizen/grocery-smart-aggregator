# Supabase (Lovable Cloud) — publishable values are safe for the browser
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
VITE_SUPABASE_PROJECT_ID=your-project-id

# Lovable AI Gateway / connectors (server-side only — never expose in the browser)
LOVABLE_API_KEY=your-lovable-api-key
GITHUB_API_KEY=your-github-connection-key
